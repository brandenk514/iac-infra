{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update docker_image resources in OpenTofu/Terraform",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": [
        "resource\\s+\"docker_image\"\\s+\"[^\"]+\"\\s*\\{[^}]*?name\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^\"@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "linuxserver.io images (linuxserver/* and lscr.io/linuxserver/*) use non-semver tags — older `X.Y.Z` (e.g. 10.11.11) and newer `X.Y[.Z]ubuNNNN[-lsN]` (e.g. 12.1ubu2604-ls50). The default `docker` versioning can't detect new releases across these formats, so use an explicit regex versioning that accepts both.",
      "matchDepPatterns": [
        "^linuxserver/",
        "^lscr\\.io/linuxserver/"
      ],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?:\\.(?<patch>\\d+))?(?:ubu\\d{4})?(?:-[a-z]+)?(?:-ls\\d+)?$"
    }
  ]
}
