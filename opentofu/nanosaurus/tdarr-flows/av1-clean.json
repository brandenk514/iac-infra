{
  "_id": "av1cln001",
  "name": "AV1 Encode + Clean Audio/Subs",
  "description": "Removes non-English subtitles, keeps only eng/jpn/hin/kor audio, then transcodes to AV1 if not already encoded. Notifies Sonarr/Radarr on completion.",
  "tags": "",
