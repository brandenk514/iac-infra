# Copy this file to terraform.tfvars and fill in real values.
# terraform.tfvars is git-ignored and will never be committed.

# ---------------------------------------------------------------------------
# SSH Connection to the Docker host
# ---------------------------------------------------------------------------
ssh_user = "your-ssh-user"
ssh_host = "192.168.x.x"
ssh_port = 22

# ---------------------------------------------------------------------------
# Paths (defaults usually work — override only if your layout differs)
# ---------------------------------------------------------------------------
# docker_mnt       = "/mnt/r5-dstor/containers"
# tovpn_mnt        = "/mnt/r5-dstor/tovpn-repo"

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# timezone = "America/Los_Angeles"
# puid     = "1000"
# pgid     = "1000"

# ---------------------------------------------------------------------------
# Traefik / Cloudflare
# ---------------------------------------------------------------------------
traefik_dashboard_credentials = "user:htpasswd-hash-here"
cf_dns_api_token              = "your-cloudflare-api-token"

# ---------------------------------------------------------------------------
# Transmission / OpenVPN
# ---------------------------------------------------------------------------
openvpn_username = "your-nordvpn-service-username"
openvpn_password = "your-nordvpn-service-password"

# ---------------------------------------------------------------------------
# Immich
# ---------------------------------------------------------------------------
# immich_version   = "v2.7.4"
db_password        = "your-postgres-password"
# db_username      = "uac-pg"
# db_database_name = "uac-photos"
# db_data_location = "/mnt/r5-dstor/containers/immich-repo/postgres"
# upload_location  = "/mnt/r5-dstor/containers/immich-repo/upload"

# ---------------------------------------------------------------------------
# NFS / Media
# ---------------------------------------------------------------------------
# media_server      = "192.168.105.20"
# media_library_mnt = ":/mnt/backup_pool/media-backup-pool"

# ---------------------------------------------------------------------------
# Beszel
# ---------------------------------------------------------------------------
# beszel_agent_hub_url = "https://monitor.local.uaccloud.com"
beszel_agent_key     = "ssh-ed25519 AAAA..."
beszel_agent_token   = "your-beszel-token"

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
webui_secret_key = "your-webui-secret"
